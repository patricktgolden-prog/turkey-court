# Copy to .env.local, or run `vercel env pull .env.local` after deploying.

# Postgres connection string. The Neon integration on Vercel sets this for you.
DATABASE_URL=

# Any random string, 32+ characters. Make one (Mac or Windows) with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Only needed on your laptop. On Vercel, AI Gateway signs in automatically.
AI_GATEWAY_API_KEY=

# PRISM tracing by Block Convey. Only the key is secret: save it with the hidden-prompt command, never in chat.
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=7cc1c165-8324-4fa4-abe6-a20711624d16
PRISMTRACE_HOST=https://api.prism.blockconvey.com
